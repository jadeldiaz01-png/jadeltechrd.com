[Unit]
Description=Jadel Tech RD Agent Fleet
Wants=network-online.target docker.service
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/jadeltechrd.com/ops/agent-fleet
Environment=JADEL_FLEET_HOME=/opt/jadel-agent-fleet
Environment=JADEL_SOURCES_DIR=/opt/jadel-agent-fleet/sources
EnvironmentFile=-/etc/jadel-agent-fleet/runtime.env
ExecStart=/usr/bin/docker compose -f /opt/jadeltechrd.com/ops/agent-fleet/docker-compose.prod.yml up -d --remove-orphans control-plane support-tickets aureus
ExecStop=/usr/bin/docker compose -f /opt/jadeltechrd.com/ops/agent-fleet/docker-compose.prod.yml stop
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

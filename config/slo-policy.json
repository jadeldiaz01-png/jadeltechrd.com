{
  "schema_version": "1.1.0",
  "policy_id": "jadel-control-plane-slo-v1",
  "measurement_window_days": 30,
  "error_budget_policy": {
    "burn_alert_windows": [
      "1h",
      "6h",
      "24h"
    ],
    "freeze_noncritical_releases_on_exhaustion": true,
    "never_relax_security_gates_to_recover_slo": true
  },
  "services": [
    {
      "service_id": "public-site",
      "sli": "successful_https_page_load_ratio",
      "objective": 0.999,
      "latency_sli": "p95_document_response_ms",
      "latency_objective_ms": 1500
    },
    {
      "service_id": "commercial-intake",
      "sli": "durable_project_request_acceptance_ratio_excluding_client_and_turnstile_rejections",
      "objective": 0.9995,
      "latency_sli": "p95_server_acceptance_ms_excluding_human_challenge",
      "latency_objective_ms": 1500,
      "hard_invariants": [
        "zero_duplicate_projects_for_same_idempotency_fingerprint",
        "zero_unverified_turnstile_acceptance"
      ]
    },
    {
      "service_id": "dispatch-outbox",
      "sli": "outbox_resolution_ratio",
      "objective": 0.9999,
      "latency_sli": "p95_pending_to_dispatched_seconds",
      "latency_objective_seconds": 120,
      "hard_invariants": [
        "zero_unresolved_ambiguous_external_actions"
      ]
    },
    {
      "service_id": "policy-control-plane",
      "sli": "policy_decision_availability_ratio",
      "objective": 0.999,
      "hard_invariants": [
        "policy_unavailable_means_deny",
        "critical_action_never_model_only"
      ]
    }
  ],
  "telemetry_privacy": {
    "pii_in_operational_logs": false,
    "allowed_identifiers": [
      "correlation_id",
      "project_id",
      "workflow_instance_id",
      "policy_decision_id"
    ],
    "forbidden_fields": [
      "name",
      "email",
      "notes",
      "turnstile_token",
      "authorization",
      "payment_secret",
      "access_token"
    ]
  },
  "public_domain_certification": {
    "measurement_window_days": 30,
    "probe_interval_minutes": 10,
    "expected_slots_per_day": 144,
    "expected_slots_per_window": 4320,
    "minimum_coverage_ratio": 0.95,
    "maximum_gap_minutes": 30,
    "measurement_model": "first_attempt_no_retry; bounded retries may be diagnostic only and never replace the SLI sample",
    "window_alignment": "30 complete UTC calendar days ending at the latest certified daily rollup",
    "availability_objectives": {
      "public-site": 0.999,
      "commercial-intake-health": 0.995
    },
    "latency_objectives_ms": {
      "public-site-p95": 1500,
      "commercial-intake-health-p95": 1500
    },
    "hard_invariants": [
      "commercial intake health must report status=ok",
      "commercial intake health must report write_mode=fail-closed",
      "public site must contain the expected Jadel Tech RD marker",
      "monitoring coverage must satisfy minimum_coverage_ratio",
      "maximum blind gap must not exceed maximum_gap_minutes"
    ],
    "burn_rate_windows": [
      {
        "window": "1h",
        "threshold": 14.4,
        "minimum_window_coverage_ratio": 0.8
      },
      {
        "window": "6h",
        "threshold": 6,
        "minimum_window_coverage_ratio": 0.8
      },
      {
        "window": "24h",
        "threshold": 3,
        "minimum_window_coverage_ratio": 0.8
      }
    ],
    "alert_delivery": {
      "channel": "github_issue",
      "test_freshness_days": 30,
      "requires_create_read_comment_close_round_trip": true
    },
    "promotion_rule": "PASS only after 30 complete days satisfy coverage, maximum-gap, availability, p95 latency, error-budget, burn-rate, hard-invariant and alert-delivery checks."
  },
  "telemetry_semantics": {
    "http_duration_metric": "http.client.request.duration",
    "duration_unit": "s",
    "note": "Synthetic artifacts retain milliseconds for human readability while mapping duration to the OpenTelemetry HTTP client duration semantic convention."
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jadeltechrd.com/schemas/agent-production-readiness.schema.json",
  "title": "Jadel Tech RD Agent Production Readiness Manifest",
  "type": "object",
  "required": ["schema_version", "policy", "services"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "policy": {
      "type": "object",
      "required": ["promotion_rule", "common_gates"],
      "properties": {
        "promotion_rule": {"type": "string"},
        "common_gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id", "name", "catalog_status", "target_status", "decision",
          "primary_repository", "source_sha", "gates", "blocking_gates"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "catalog_status": {"enum": ["pilot", "research", "available"]},
          "target_status": {"const": "PRODUCTION_READY"},
          "decision": {"enum": ["BLOCKED", "CONDITIONAL", "PRODUCTION_READY"]},
          "primary_repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
          "supporting_repositories": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[^/]+/[^/]+$"}
          },
          "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "gates": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "boolean"}
          },
          "blocking_gates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "owner", "reason"],
              "properties": {
                "id": {"type": "string"},
                "owner": {"enum": ["engineering", "human_admin", "platform", "commercial", "evidence"]},
                "reason": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}

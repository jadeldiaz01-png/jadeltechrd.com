{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jadel-commercial-runtime",
  "main": "src/project-entry.mjs",
  "compatibility_date": "2026-08-31",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://jadeltechrd.com",

    // AI stays fail-closed until the activation gate replaces the placeholders
    // and turns the kill switch off in a protected environment.
    "AI_RUNTIME_MODE": "SHADOW_RECOMMEND_ONLY",
    "AI_KILL_SWITCH": "1",
    "AI_GATEWAY_ID": "REPLACE_WITH_DEDICATED_GATEWAY_ID",
    "AI_MODEL": "openai/gpt-5.6-luna",
    "AI_SOURCE_SHA": "REPLACE_WITH_EXACT_40_CHAR_DEPLOYED_SHA",
    "AI_MAX_OUTPUT_TOKENS": "1200",
    "AI_TIMEOUT_MS": "20000",
    "AI_AUTOMATED_CONTROL_ENABLED": "0",
    "AI_AUTOMATED_CONTROL_INTERVAL_MINUTES": "360",
    "AI_EMBEDDING_MODEL": "REPLACE_WITH_APPROVED_WORKERS_AI_EMBEDDING_MODEL"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jadel-commercial-runtime",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "KNOWLEDGE_INDEX",
      "index_name": "jadel-revenue-knowledge"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AI_ASSETS",
      "bucket_name": "jadel-ai-approved-assets"
    }
  ],
  "ratelimits": [
    {
      "name": "PROJECT_REQUEST_RATE_LIMITER",
      "namespace_id": "REPLACE_WITH_POSITIVE_INTEGER_NAMESPACE",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "AI_ANALYSIS_RATE_LIMITER",
      "namespace_id": "REPLACE_WITH_SEPARATE_POSITIVE_INTEGER_NAMESPACE",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "workflows": [
    {
      "name": "jadel-project-lifecycle",
      "binding": "PROJECT_WORKFLOW",
      "class_name": "ProjectLifecycleWorkflow"
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  }

  // Required runtime secrets are never committed:
  // ADMIN_API_TOKEN
  // AI_RUNTIME_TOKEN  (dedicated Cloudflare token with only the AI runtime permission)
  // CLOUDFLARE_ACCOUNT_ID is supplied as protected environment configuration.
}

}
.console-title { margin-left: .5rem; }
.console-state { margin-left: auto; color: var(--accent); font-weight: 800; letter-spacing: .12em; }
.agent-core {
  position: relative;
  width: min(340px, 82%);
  aspect-ratio: 1;
  margin: 1.5rem auto 0;
}
.core-node {
  position: absolute;
  inset: 50% auto auto 50%;
  transform: translate(-50%, -50%);
  width: 108px;
  height: 108px;
  display: grid;
  place-items: center;
  align-content: center;
  border-radius: 32px;
  border: 1px solid rgba(99,230,190,.55);
  background: radial-gradient(circle at 35% 25%, rgba(255,255,255,.16), transparent 34%), linear-gradient(145deg, rgba(99,230,190,.25), rgba(116,192,252,.11));
  box-shadow: 0 0 0 12px rgba(99,230,190,.035), 0 0 60px rgba(99,230,190,.18);
  z-index: 3;
}
.core-node strong { font-size: 2rem; letter-spacing: -.06em; }
.core-node small { color: var(--accent); font-size: .55rem; letter-spacing: .12em; }
.core-orbit { position: absolute; inset: 50% auto auto 50%; transform: translate(-50%, -50%); border: 1px solid rgba(255,255,255,.11); border-radius: 50%; animation: spin 22s linear infinite; }
.core-orbit span { position: absolute; min-width: 58px; height: 28px; display: grid; place-items: center; padding: 0 .45rem; border-radius: 999px; border: 1px solid rgba(255,255,255,.12); background: #0b1120; color: var(--muted); font-size: .64rem; letter-spacing: .04em; box-shadow: 0 8px 24px rgba(0,0,0,.28); }
.orbit-a { width: 245px; height: 245px; }
.orbit-b { width: 320px; height: 320px; animation-direction: reverse; animation-duration: 28s; }
.orbit-a span:nth-child(1) { left: 50%; top: -14px; transform: translateX(-50%); }
.orbit-a span:nth-child(2) { right: -23px; top: 54%; }
.orbit-a span:nth-child(3) { left: -18px; top: 56%; }
.orbit-b span:nth-child(1) { left: 50%; bottom: -14px; transform: translateX(-50%); }
.orbit-b span:nth-child(2) { right: -25px; top: 28%; }
.orbit-b span:nth-child(3) { left: -20px; top: 27%; }
@keyframes spin { to { transform: translate(-50%, -50%) rotate(360deg); } }
.core-orbit span { animation: counter-spin 22s linear infinite; }
.orbit-b span { animation-duration: 28s; animation-direction: reverse; }
@keyframes counter-spin { to { rotate: -360deg; } }
.console-events { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; display: grid; gap: .5rem; }
.console-events > div { display: grid; grid-template-columns: 48px 1fr; gap: 0 .65rem; align-items: center; padding: .6rem .72rem; border: 1px solid rgba(255,255,255,.08); border-radius: .8rem; background: rgba(5, 8, 15, .72); backdrop-filter: blur(10px); }
.console-events span { grid-row: 1 / 3; font-size: .62rem; font-weight: 900; letter-spacing: .08em; }
.console-events b { font-size: .78rem; }
.console-events small { color: var(--muted-2); font-size: .67rem; }
.event-ok { color: var(--success); }
.event-wait { color: var(--warning); }
.signal-strip { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin: 1.25rem 0 0; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; background: var(--line); }
.signal-strip > div { min-height: 126px; display: flex; flex-direction: column; justify-content: center; padding: 1.2rem; background: #080c15; }
.signal-strip strong { font-size: 1.8rem; letter-spacing: -.05em; }
.signal-strip span { color: var(--muted-2); font-size: .78rem; max-width: 18ch; }
.section-block { padding: clamp(5.5rem, 11vw, 9rem) 0 0; }
.section-heading { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, .85fr); align-items: end; gap: 2rem; margin-bottom: 2rem; }
.section-heading h2, .governance-panel h2, .final-cta h2 { margin: .55rem 0 0; font-size: clamp(2.2rem, 5vw, 4.5rem); max-width: 15ch; }
.section-heading > p, .governance-panel > div > p, .final-cta p { margin: 0; color: var(--muted); max-width: 60ch; }
.filter-row { display: flex; flex-wrap: wrap; gap: .55rem; margin: 1.2rem 0 1.5rem; }
.filter-chip { min-height: 38px; padding: .5rem .78rem; border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,.025); color: var(--muted); cursor: pointer; font-size: .82rem; transition: .2s ease; }
.filter-chip:hover, .filter-chip.is-active { color: #07110e; background: var(--accent); border-color: var(--accent); }
.services-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
.service-card { min-height: 430px; display: flex; flex-direction: column; padding: 1.35rem; border: 1px solid var(--line); border-radius: 20px; background: radial-gradient(circle at 85% 0%, rgba(116,192,252,.06), transparent 34%), linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.018)); transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease; }
.service-card:hover { transform: translateY(-5px); border-color: rgba(99,230,190,.28); box-shadow: 0 24px 56px rgba(0,0,0,.24); }
.service-topline { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
.service-icon { width: 2.4rem; height: 2.4rem; display: grid; place-items: center; border-radius: .8rem; border: 1px solid var(--line); background: rgba(255,255,255,.04); color: var(--accent-2); font-weight: 900; }
.status-badge { max-width: 68%; padding: .34rem .55rem; border-radius: 999px; font-size: .61rem; font-weight: 850; letter-spacing: .04em; text-transform: uppercase; text-align: center; }
.status-available { color: #8ce99a; background: rgba(105,219,124,.085); border: 1px solid rgba(105,219,124,.18); }
.status-pilot { color: #ffd43b; background: rgba(255,212,59,.08); border: 1px solid rgba(255,212,59,.18); }
.status-research { color: #bac8ff; background: rgba(177,151,252,.09); border: 1px solid rgba(177,151,252,.18); }
.service-card h3 { margin: 1.25rem 0 .65rem; font-size: 1.45rem; }
.service-card > p { margin: 0; color: var(--muted); font-size: .92rem; }
.service-deliverables { display: flex; flex-wrap: wrap; gap: .42rem; padding: 0; margin: 1.2rem 0 1.5rem; list-style: none; }
.service-deliverables li { padding: .35rem .52rem; border: 1px solid rgba(255,255,255,.08); border-radius: .55rem; color: var(--muted-2); font-size: .68rem; background: rgba(255,255,255,.025); }
.service-footer { margin-top: auto; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,.07); display: flex; align-items: end; justify-content: space-between; gap: .75rem; }
.price-caption { display: block; color: var(--muted-2); font-size: .62rem; text-transform: uppercase; letter-spacing: .08em; }
.service-footer strong { display: block; margin-top: .2rem; font-size: .82rem; }
.mini-action { padding: .46rem .65rem; border: 1px solid rgba(99,230,190,.25); border-radius: .65rem; background: rgba(99,230,190,.07); color: var(--accent); cursor: pointer; 
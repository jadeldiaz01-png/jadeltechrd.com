:root {
  color-scheme: dark;
  --bg: #05070d;
  --bg-2: #090d17;
  --surface: rgba(15, 22, 38, 0.78);
  --surface-strong: #0d1422;
  --surface-soft: rgba(255, 255, 255, 0.035);
  --text: #f4f7ff;
  --muted: #a7b3c8;
  --muted-2: #7f8da6;
  --line: rgba(255, 255, 255, 0.11);
  --line-strong: rgba(255, 255, 255, 0.18);
  --accent: #63e6be;
  --accent-2: #74c0fc;
  --accent-3: #b197fc;
  --danger: #ff8787;
  --warning: #ffd43b;
  --success: #69db7c;
  --max: 1180px;
  --radius: 24px;
  --shadow: 0 28px 80px rgba(0, 0, 0, 0.34);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at 10% 0%, rgba(116, 192, 252, 0.10), transparent 30rem),
    radial-gradient(circle at 90% 4%, rgba(177, 151, 252, 0.09), transparent 26rem),
    linear-gradient(180deg, #05070d 0%, #070b13 45%, #05070d 100%);
  color: var(--text);
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  line-height: 1.6;
  text-rendering: optimizeLegibility;
}
body::selection { background: rgba(99, 230, 190, .28); }
a { color: inherit; }
button, input, select, textarea { font: inherit; }
button { color: inherit; }
[hidden] { display: none !important; }

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  z-index: 1000;
  padding: .75rem 1rem;
  background: white;
  color: black;
}
.skip-link:focus { left: 1rem; top: 1rem; }

.shell {
  width: min(calc(100% - 2rem), var(--max));
  margin-inline: auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid var(--line);
  background: rgba(5, 7, 13, 0.74);
  backdrop-filter: blur(20px) saturate(130%);
}
.header-inner,
.footer-inner {
  min-height: 72px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}
.brand {
  display: inline-flex;
  align-items: center;
  gap: .72rem;
  text-decoration: none;
  font-weight: 850;
  letter-spacing: -.025em;
}
.brand-mark {
  width: 2.35rem;
  height: 2.35rem;
  display: grid;
  place-items: center;
  border: 1px solid rgba(99, 230, 190, .45);
  border-radius: .85rem;
  background:
    linear-gradient(145deg, rgba(99, 230, 190, .24), rgba(116, 192, 252, .14));
  box-shadow: inset 0 1px 0 rgba(255,255,255,.09), 0 0 28px rgba(99,230,190,.08);
  color: var(--accent);
  font-size: .78rem;
  letter-spacing: .06em;
}
.nav,
.site-footer nav {
  display: flex;
  flex-wrap: wrap;
  gap: .25rem;
  align-items: center;
}
.nav a,
.site-footer a {
  text-decoration: none;
  color: var(--muted);
  transition: color .2s ease, background .2s ease, transform .2s ease;
}
.nav a {
  padding: .52rem .72rem;
  border-radius: .72rem;
  font-size: .93rem;
}
.nav a:hover,
.nav a[aria-current="page"] {
  color: var(--text);
  background: rgba(255,255,255,.055);
}

/* Commercial 2026 homepage */
.commercial-home {
  position: relative;
  isolation: isolate;
  --mx: 50%;
  --my: 6rem;
}
.commercial-home::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: -1;
  background: radial-gradient(520px circle at var(--mx) var(--my), rgba(99, 230, 190, .055), transparent 55%);
}

.hero-v2 {
  min-height: min(820px, calc(100vh - 72px));
  display: grid;
  grid-template-columns: minmax(0, 1.02fr) minmax(420px, .98fr);
  gap: clamp(2.5rem, 6vw, 6rem);
  align-items: center;
  padding: clamp(5rem, 10vw, 8.5rem) 0 clamp(4rem, 8vw, 7rem);
  position: relative;
}
.hero-v2::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 100vw;
  transform: translateX(-50%);
  border-bottom: 1px solid rgba(255,255,255,.07);
}
.eyebrow,
.card-kicker {
  color: var(--accent);
  font-size: .76rem;
  font-weight: 850;
  letter-spacing: .15em;
  text-transform: uppercase;
}
.live-dot {
  display: inline-block;
  width: .48rem;
  height: .48rem;
  margin-right: .5rem;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 5px rgba(99,230,190,.10), 0 0 24px rgba(99,230,190,.38);
  animation: pulse 2.4s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(.9); opacity: .75; }
  50% { transform: scale(1.1); opacity: 1; }
}
h1, h2, h3 {
  line-height: 1.08;
  letter-spacing: -.04em;
  text-wrap: balance;
}
.hero-v2 h1 {
  margin: .85rem 0 1.25rem;
  font-size: clamp(3.25rem, 7vw, 6.6rem);
  max-width: 12ch;
}
.hero-v2 h1 span {
  display: block;
  color: transparent;
  background: linear-gradient(105deg, var(--accent) 0%, var(--accent-2) 48%, var(--accent-3) 100%);
  -webkit-background-clip: text;
  background-clip: text;
}
.hero-v2 .lead {
  max-width: 680px;
  margin: 0;
  color: var(--muted);
  font-size: clamp(1.06rem, 2vw, 1.26rem);
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: .8rem;
  margin-top: 2rem;
}
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: .45rem;
  min-height: 48px;
  padding: .76rem 1.08rem;
  border-radius: .9rem;
  border: 1px solid transparent;
  text-decoration: none;
  font-weight: 780;
  cursor: pointer;
  transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease, background .2s ease;
}
.button:hover { transform: translateY(-2px); }
.button.primary {
  color: #04110d;
  background: linear-gradient(135deg, #74f0cb, #7bd5ff);
  box-shadow: 0 14px 40px rgba(99, 230, 190, .16);
}
.button.primary:hover { box-shadow: 0 18px 48px rgba(99, 230, 190, .24); }
.button.secondary {
  border-color: var(--line);
  background: rgba(255,255,255,.035);
  color: var(--text);
}
.button.secondary:hover { border-color: var(--line-strong); background: rgba(255,255,255,.06); }
.button.full { width: 100%; }
.button:disabled { opacity: .45; cursor: not-allowed; transform: none; }
.hero-trust {
  display: flex;
  flex-wrap: wrap;
  gap: .6rem 1rem;
  margin-top: 1.65rem;
  color: var(--muted-2);
  font-size: .84rem;
}
.hero-trust span { white-space: nowrap; }

.agent-console {
  position: relative;
  min-height: 510px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 28px;
  background:
    linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.015)),
    radial-gradient(circle at 50% 40%, rgba(116,192,252,.08), transparent 48%),
    #090d16;
  box-shadow: var(--shadow), inset 0 1px 0 rgba(255,255,255,.06);
  overflow: hidden;
}
.agent-console::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
  background-size: 28px 28px;
  mask-image: linear-gradient(to bottom, black, transparent 78%);
  pointer-events: none;
}
.console-bar {
  height: 54px;
  display: flex;
  align-items: center;
  gap: .38rem;
  padding: 0 1rem;
  border-bottom: 1px solid var(--line);
  color: var(--muted-2);
  font-size: .72rem;
  letter-spacing: .04em;
}
.console-dot { width: .5rem; height: .5rem; border-radius: 50%; background: #3e4758; 
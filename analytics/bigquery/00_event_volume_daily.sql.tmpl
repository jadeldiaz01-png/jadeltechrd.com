-- GA4 daily raw-event health.
-- Replace __GCP_PROJECT_ID__ after the GA4 -> BigQuery link creates analytics_555066228.
SELECT
  _TABLE_SUFFIX AS event_date,
  COUNT(*) AS event_count,
  COUNT(DISTINCT user_pseudo_id) AS pseudo_users,
  COUNTIF(event_name = 'page_view') AS page_views,
  COUNTIF(event_name = 'generate_lead') AS generated_leads
FROM `__GCP_PROJECT_ID__.analytics_555066228.events_*`
WHERE _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY))
                        AND FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY))
GROUP BY event_date
ORDER BY event_date DESC;

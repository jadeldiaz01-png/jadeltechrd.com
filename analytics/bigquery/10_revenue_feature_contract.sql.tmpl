-- Revenue intelligence privacy-safe aggregate feature contract.
-- Requires GA4 daily export dataset analytics_555066228.
-- Browser analytics is not a system of record for qualification, customers or money.
WITH base AS (
  SELECT
    PARSE_DATE('%Y%m%d', event_date) AS event_date,
    event_name,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key='offer_id' LIMIT 1) AS offer_id,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key='utm_source' LIMIT 1) AS utm_source,
    (SELECT value.string_value FROM UNNEST(event_params) WHERE key='utm_medium' LIMIT 1) AS utm_medium
  FROM `__GCP_PROJECT_ID__.analytics_555066228.events_*`
  WHERE _TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE(), INTERVAL 90 DAY))
                          AND FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY))
)
SELECT
  event_date,
  COALESCE(offer_id, 'unknown') AS offer_id,
  COALESCE(utm_source, '(direct)') AS utm_source,
  COALESCE(utm_medium, '(none)') AS utm_medium,
  COUNTIF(event_name='page_view') AS page_views,
  COUNTIF(event_name='offer_view') AS offer_views,
  COUNTIF(event_name='offer_cta_click') AS offer_cta_clicks,
  COUNTIF(event_name='intake_start') AS intake_starts,
  COUNTIF(event_name='generate_lead') AS generated_leads,
  SAFE_DIVIDE(COUNTIF(event_name='generate_lead'), NULLIF(COUNTIF(event_name='offer_view'),0)) AS offer_to_lead_rate
FROM base
GROUP BY event_date, offer_id, utm_source, utm_medium
ORDER BY event_date DESC;
